params {
    container = "public.ecr.aws/cirrobio/qupath:0046339"
    image_format = "vsi"
    // SVS and similar formats already carry lossy JPEG tiles written by the scanner, so
    // a lossless codec re-encodes them larger without recovering any fidelity.
    compression = "JPEG"
    pyramid_scale = 2
    tile_size = 1024
    skip_existing = false
    cpus = 4
    memory_gb = 16
    max_retries = 2
}

process {
    withName: 'convert_image|convert_image_series' {
        cpus = params.cpus
        memory = { (params.memory_gb * task.attempt).GB }
        // Retry only what more memory or another host can fix -- JVM and kernel OOM,
        // and Batch/Spot reclamation. QuPath exits 255 on a conversion it cannot do,
        // which must stay loud. 'finish' lets the images already in flight publish.
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
        maxRetries = params.max_retries
    }
}

profiles {
    // Cirro configures its own container runtime; this is for running standalone.
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
}
